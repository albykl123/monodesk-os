#!/bin/sh
# ==============================================================================
# MONODESK OS — Live-Build Master Auto Configuration
# Pinned to Debian 13 (Trixie) AMD64 with hybrid UEFI / BIOS boot
# ==============================================================================

set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --parent-distribution trixie \
    --distribution-chroot trixie \
    --distribution-binary trixie \
    --parent-distribution-chroot trixie \
    --parent-distribution-binary trixie \
    --architectures amd64 \
    --linux-flavours amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --parent-archive-areas "main contrib non-free non-free-firmware" \
    --bootloader grub-efi \
    --binary-images iso-hybrid \
    --iso-application "MONODESK OS 2.0.0 Universal PC" \
    --iso-preparer "MONODESK Distribution Engineering Team" \
    --iso-publisher "MONODESK Project" \
    --iso-volume "MONODESK_2_0_AMD64" \
    --memtest none \
    --win32-loader false \
    --security true \
    --updates true \
    --backports false \
    --apt-recommends false \
    --apt-indices false \
    --cache true \
    --cache-packages true \
    --cache-stages "bootstrap chroot rootfs" \
    --compression xz \
    "${@}"
