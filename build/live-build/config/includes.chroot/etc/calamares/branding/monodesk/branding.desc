# ==============================================================================
# MONODESK OS — Calamares Branding Descriptor
# ==============================================================================

componentName: monodesk
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

strings:
    productName:         "MONODESK OS"
    shortProductName:    "MONODESK"
    version:             "1.0 Universal PC Edition"
    shortVersion:        "1.0"
    versionedName:       "MONODESK OS 1.0"
    shortVersionedName:  "MONODESK 1.0"
    bootloaderEntryName: "MONODESK OS"
    productUrl:          "https://github.com/monodesk-os"
    supportUrl:          "https://github.com/monodesk-os/issues"
    releaseNotesUrl:     "https://github.com/monodesk-os/releases"

images:
    productLogo:         "/usr/share/icons/hicolor/scalable/apps/monodesk-icon.svg"
    productIcon:         "/usr/share/icons/hicolor/scalable/apps/monodesk-icon.svg"

style:
   sidebarBackground:    "#0b0c10"
   sidebarText:          "#e0e0e0"
   sidebarTextSelect:    "#ffffff"

slideshow:               "show.qml"
slideshowAPI: 2
