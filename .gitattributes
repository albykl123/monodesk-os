# Enforce LF for all repository files, especially Linux executables and configurations
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.qml text eol=lf
*.conf text eol=lf
*.desktop text eol=lf
*.list text eol=lf
*.service text eol=lf
/build/live-build/config/includes.chroot/usr/bin/* text eol=lf
/system/hardware/* text eol=lf
/system/power/* text eol=lf
