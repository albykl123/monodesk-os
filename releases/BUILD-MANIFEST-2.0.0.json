{
  "project": "MONODESK OS",
  "version": "2.0.0",
  "edition": "Universal PC Edition",
  "architecture": "x86_64",
  "base_os": "Debian GNU/Linux 13 (Trixie)",
  "desktop_engine": {
    "primary": "MONODESK Wayland (Hyprland + Quickshell / Nebula)",
    "recovery": "MONODESK Recovery (X11 + XFWM4)",
    "session_router": "/usr/bin/monodesk-session"
  },
  "profiles": {
    "standard": {
      "target_ram": ">= 6 GB",
      "compositor": "Full animations, blur, window shadows",
      "zram_percent": 25,
      "power_profile": "balanced"
    },
    "lite": {
      "target_ram": "< 6 GB",
      "compositor": "Reduced animations, no blur/shadows",
      "zram_percent": 50,
      "power_profile": "power-saver"
    }
  },
  "upstream_dependencies": {
    "nebula": {
      "repository": "https://github.com/LilaccFlowerr/Nebula",
      "commit": "9749c30402b4e6712d0222c48b645fa357d0217e",
      "license": "GNU AGPL-3.0"
    },
    "m3shapes": {
      "repository": "https://github.com/soramanew/m3shapes",
      "commit": "8a6fe8961749887d677700b6508e0c9249968b7e",
      "license": "Apache-2.0"
    }
  },
  "build_pipeline": {
    "automation": ".github/workflows/build-iso.yml",
    "runner": "ubuntu-24.04 (GitHub Actions)",
    "package_manager": "apt (live-build for Debian 13 Trixie)",
    "iso_filename": "monodesk-os-2.0.0-universal-amd64.iso"
  }
}
